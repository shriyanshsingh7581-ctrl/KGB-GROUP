{
  "entities": {
    "Application": {
      "title": "Application",
      "description": "A candidate job application submitted through the KGB Group landing page.",
      "type": "object",
      "properties": {
        "fullName": {
          "type": "string",
          "description": "Candidate full name",
          "minLength": 2,
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "Candidate WhatsApp or mobile number",
          "minLength": 10,
          "maxLength": 20,
          "pattern": "^[0-9+\\-\\s]{10,20}$"
        },
        "email": {
          "type": "string",
          "description": "Candidate email address",
          "maxLength": 150
        },
        "city": {
          "type": "string",
          "description": "Candidate city or location",
          "maxLength": 100
        },
        "qualification": {
          "type": "string",
          "description": "Highest qualification level",
          "minLength": 1,
          "maxLength": 100
        },
        "role": {
          "type": "string",
          "description": "Desired job role",
          "minLength": 2,
          "maxLength": 150
        },
        "notes": {
          "type": "string",
          "description": "Additional notes or experience details",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "description": "Application lead status",
          "enum": ["New", "Contacted", "Shortlisted", "Placed"],
          "maxLength": 30
        },
        "timestamp": {
          "type": "string",
          "description": "ISO timestamp string of submission",
          "minLength": 10,
          "maxLength": 40
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        }
      },
      "required": [
        "fullName",
        "phone",
        "email",
        "city",
        "qualification",
        "role",
        "notes",
        "status",
        "timestamp",
        "createdAt"
      ]
    },
    "Poster": {
      "title": "Poster",
      "description": "A dynamic announcement or hiring poster uploaded by HR Admin via Cloudinary.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Poster headline or announcement title",
          "minLength": 2,
          "maxLength": 150
        },
        "imageUrl": {
          "type": "string",
          "description": "Cloudinary secure image URL",
          "minLength": 10,
          "maxLength": 500
        },
        "createdAt": {
          "type": "number",
          "description": "Epoch timestamp in milliseconds"
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        }
      },
      "required": ["title", "imageUrl", "createdAt", "serverCreatedAt"]
    },
    "DynamicJob": {
      "title": "DynamicJob",
      "description": "A dynamically created job vacancy added by HR Admin.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "description": "Job title",
          "minLength": 2,
          "maxLength": 150
        },
        "salary": {
          "type": "string",
          "description": "Salary package details",
          "minLength": 2,
          "maxLength": 100
        },
        "jobType": {
          "type": "string",
          "description": "Work arrangement type",
          "enum": ["WFH", "Office", "Hybrid"],
          "maxLength": 30
        },
        "location": {
          "type": "string",
          "description": "Job location",
          "minLength": 2,
          "maxLength": 120
        },
        "qualifications": {
          "type": "string",
          "description": "Required qualifications",
          "minLength": 2,
          "maxLength": 250
        },
        "createdAt": {
          "type": "number",
          "description": "Epoch timestamp in milliseconds"
        },
        "serverCreatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        }
      },
      "required": [
        "title",
        "salary",
        "jobType",
        "location",
        "qualifications",
        "createdAt",
        "serverCreatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized HR administrator record.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Verified administrator email",
          "minLength": 3,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of admin creation"
        }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Stores candidate applications submitted via the public registration form."
    },
    "/posters/{posterId}": {
      "schema": { "$ref": "#/entities/Poster" },
      "description": "Stores dynamic announcement and hiring posters uploaded via Cloudinary."
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/DynamicJob" },
      "description": "Stores dynamically added job openings."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Stores authorized HR admin UIDs."
    }
  }
}
